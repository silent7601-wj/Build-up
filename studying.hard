          price: 300,
        },
      ];
      const shopCurrency = [
        { id: "bling-500", amount: 500, price: "₩4,900", badge: "가볍게 시작" },
        { id: "bling-1200", amount: 1200, price: "₩9,900", badge: "가장 인기" },
        { id: "bling-3000", amount: 3000, price: "₩19,900", badge: "더 큰 혜택" },
      ];
      const shopPointsKey = "buildup-shop-bling";
      const shopEntitlementsKey = "buildup-shop-entitlements";
      const shopCartKey = "buildup-shop-cart";

      function readShopPoints() {
        const points = Number(localStorage.getItem(shopPointsKey) || 1200);
        return Number.isFinite(points) && points >= 0 ? points : 1200;
      }

      function readShopEntitlements() {
        try {
          return JSON.parse(localStorage.getItem(shopEntitlementsKey) || "{}");
        } catch {
          return {};
        }
      }

      function hasShopEntitlement(name) {
        const value = readShopEntitlements()[name];
        return value === "permanent" || Number(value || 0) > Date.now();
      }

      function saveShopEntitlement(name, days) {
        const entitlements = readShopEntitlements();
        const current = entitlements[name];
        if (current === "permanent") return;
        if (days === "permanent") {
          entitlements[name] = "permanent";
        } else {
          const nextExpiry = Date.now() + days * 24 * 60 * 60 * 1000;
          entitlements[name] = Math.max(Number(current || 0), nextExpiry);
        }
        localStorage.setItem(shopEntitlementsKey, JSON.stringify(entitlements));
      }

      function readShopCart() {
        try {
          const cart = JSON.parse(localStorage.getItem(shopCartKey) || "[]");
          return Array.isArray(cart)
            ? [...new Set(cart)].filter((id) =>
                shopProducts.some((product) => product.id === id),
              )
            : [];
        } catch {
          return [];
        }
      }

      function saveShopCart(cart) {
        localStorage.setItem(shopCartKey, JSON.stringify(cart));
      }

      function renderShop(category = "all") {
        const products = shopProducts.filter(
          (product) => category === "all" || product.category === category,
        );
        shopPoints.textContent = readShopPoints().toLocaleString("ko-KR");
        shopGrid.innerHTML = products
          .map(
            (product) => `
              <article class="shop-product product-${product.theme || "focus"}">
                <div class="shop-product-icon ${product.iconClass || ""}">${product.icon}</div>
                <h2>${escapeHtml(product.name)}</h2>
                <p>${escapeHtml(product.description)}</p>
                <div class="shop-product-footer">
                  <span class="shop-price">${product.price.toLocaleString("ko-KR")}P</span>
                  <button type="button" class="btn btn-secondary shop-add-button" data-shop-product="${product.id}">담기</button>
                </div>
              </article>
            `,
          )
          .join("");
        shopCurrencyGrid.innerHTML = shopCurrency
          .map(
            (pack) => `
              <article class="shop-currency-card">
                <strong>${escapeHtml(pack.badge)}</strong>
                <p>${pack.amount.toLocaleString("ko-KR")} 포인트 충전</p>
                <button type="button" class="btn btn-secondary shop-buy-currency" data-shop-amount="${pack.amount}">${pack.price} 결제</button>
              </article>
            `,
          )
          .join("");
        renderShopCart();
        renderShopEntitlements();
      }

      function renderShopEntitlements() {
        const labels = [
          ["adFreeUntil", "광고 제거"],
          ["lecturePassUntil", "강의 더보기"],
          ["downloadPassUntil", "자료 다운로드"],
          ["summaryPlusUntil", "요약정리 플러스"],
        ];
        const active = labels
          .filter(([key]) => hasShopEntitlement(key))
          .map(([, label]) => label);
        shopEntitlement.textContent = active.length
          ? `사용 중인 기능: ${active.join(", ")}`
          : "기능권을 구매하면 요약정리·강의·자료 화면에서 바로 사용할 수 있습니다.";
      }

      function renderShopCart() {
        const cart = readShopCart();
        const items = cart
          .map((id) => shopProducts.find((product) => product.id === id))
          .filter(Boolean);
        const total = items.reduce((sum, product) => sum + product.price, 0);
        shopCartTotal.textContent = `${total.toLocaleString("ko-KR")}P`;
        shopCartList.innerHTML = items.length
          ? items
              .map(
                (product, index) => `
                  <div class="shop-cart-item">
                    <span>${escapeHtml(product.name)}</span>
                    <button type="button" class="text-button danger shop-remove-button" data-shop-index="${index}">삭제</button>
                  </div>
                `,
              )
              .join("")
          : '<span class="community-meta">담은 상품이 없습니다.</span>';
      }

      function schoolName(school) {
        return {
          elementary: "초등학교",
          middle: "중학교",
          high: "고등학교",
          university: "대학교",
        }[school] || "중학교";
      }

      function subjectName(school, subjectId) {
        return subjectDetails[school]?.[subjectId]?.name ||
          {
            korean: "국어",
            math: "수학",
            english: "영어",
            science: "과학",
            society: "사회",
            history: "역사",
          }[subjectId] || "과목";
      }

      function renderSchoolGrades(school) {
        const gradeCounts = {
          elementary: 6,
          middle: 3,
          high: 3,
          university: 4,
        };
        const gradeCount = gradeCounts[school] || 3;
        selectedGrade = Math.min(selectedGrade, gradeCount);
        schoolGradeList.innerHTML = Array.from(
          { length: gradeCount },
          (_, index) => {
            const grade = index + 1;
            const active = grade === selectedGrade;
            return `<button type="button" class="school-grade-link${active ? " active" : ""}" data-school-grade="${grade}" aria-pressed="${active}">${grade}학년</button>`;
          },
        ).join("");
      }

      function renderSchoolResource(
        resourceType,
        school,
        subjectId,
        highlightSubject = true,
      ) {
        const subject = subjectDetails[school]?.[subjectId] || subjectDetails.middle.korean;
        const name = subjectName(school, subjectId);
        selectedResourceType = resourceType;
        selectedSchool = school;
        currentSubjectId = subjectId;
        schoolSelectedSubject.textContent = `${schoolName(school)} · ${name}`;
        schoolResourceTitle.textContent = `${name} ${resourceType === "summary" ? "요약정리" : resourceType === "lecture" ? "강의" : "공부자료"}`;
        schoolResourceDescription.textContent = subject.description;
        schoolSubjectLinks.forEach((link) => {
          link.classList.toggle(
            "active",
            highlightSubject && link.dataset.schoolSubject === subjectId,
          );
        });
        if (resourceType === "summary") {
          const summary = curriculumSummaries[school]?.[subjectId] || curriculumSummaries.middle[subjectId];
          const summaryLocked = !hasShopEntitlement("summaryPlusUntil");
          schoolResourceBody.innerHTML = `
            <h3>2022 개정 교육과정 핵심 요약</h3>
            <p>${escapeHtml(summary.core)}</p>
            <ul>
              <li>${escapeHtml(summary.achievement)}</li>
              ${summaryLocked ? `<li>복습 질문과 상세 체크리스트는 요약정리 플러스 구매 후 열립니다.</li>` : `<li>복습 질문: ${escapeHtml(summary.question)}</li>${summary.checklist.map((item) => `<li>${escapeHtml(item)}</li>`).join("")}`}
            </ul>`;
        } else if (resourceType === "lecture") {
          const lectures = readLectures(school, subjectId);
          const lectureLocked = !hasShopEntitlement("lecturePassUntil");
          schoolResourceBody.innerHTML = `
            <h3>개념을 영상으로 익혀 보세요</h3>
            <p>${lectureLocked ? "강의 더보기 30일을 구매하면 추가 강의와 전체 강의 목록을 이용할 수 있습니다." : lectures.length ? `${lectures.length}개의 등록된 강의가 있습니다.` : "아직 등록된 강의가 없습니다. 강의 메뉴에서 유튜브 영상을 추가해 보세요."}</p>
            <ul>${lectureLocked ? `<li>${escapeHtml(subject.concept)}</li>` : lectures.length ? lectures.map((lecture) => `<li>${escapeHtml(lecture.title)}</li>`).join("") : `<li>${escapeHtml(subject.concept)}</li>`}</ul>`;
        } else {
          const downloadLocked = !hasShopEntitlement("downloadPassUntil");
          schoolResourceBody.innerHTML = `
            <h3>학습 범위와 추천 자료</h3>
            <p>${escapeHtml(subject.knowledge)}</p>
            <ul>
              <li>학습 범위: ${escapeHtml(subject.scope)}</li>
              <li>추천 복습: ${escapeHtml(subject.tip)}</li>
              <li>${downloadLocked ? "자료 다운로드 30일을 구매하면 학습 자료를 저장할 수 있습니다." : "자료 다운로드가 활성화되었습니다. 필요한 자료를 저장해 보세요."}</li>
            </ul>`;
        }
        schoolResourceContent.hidden = false;
      }

      function showSchoolSubjects(resourceType, school, subjectId = "korean") {
        showPage(`school-subjects-${resourceType}-${school}`);
        renderSchoolResource(resourceType, school, subjectId);
      }

      function showPage(pageName, updateHistory = true) {
        const isHomePage = pageName === "home";
        const isSubjectListPage =
          pageName === "subjects-middle" ||
          pageName === "subjects-high" ||
          pageName === "subjects-elementary" ||
          pageName === "subjects-university";
        const isSchoolSubjectsPage = pageName.startsWith("school-subjects-");
        const isNextPage = pageName === "next";
        const isLecturesPage = pageName === "lectures";
        const isMaterialsPage = pageName === "materials";
        const isResourcePage = isNextPage || isLecturesPage || isMaterialsPage;
        const isLectureSubjectPage = pageName.startsWith("lecture-subject-");
        const isSummarySubjectPage = pageName.startsWith("summary-subject-");
        const isSubjectPage =
          pageName.startsWith("subject-") ||
          isLectureSubjectPage ||
          isSummarySubjectPage;
        const isContactPage = pageName === "contact";
        const isCommunityPage = pageName === "community";
        const isShopPage = pageName === "shop";
        homePage.classList.toggle("active", isHomePage);
        nextPage.classList.toggle("active", isNextPage);
        schoolSubjectsPage.classList.toggle(
          "active",
          isSubjectListPage || isSchoolSubjectsPage,
        );
        lecturesPage.classList.toggle("active", isLecturesPage);
        materialsPage.classList.toggle("active", isMaterialsPage);
        subjectPage.classList.toggle("active", isSubjectPage);
        communityPage.classList.toggle("active", isCommunityPage);
        shopPage.classList.toggle("active", isShopPage);
        contactPage.classList.toggle("active", isContactPage);
        homePage.setAttribute("aria-hidden", String(!isHomePage));
        nextPage.setAttribute("aria-hidden", String(!isNextPage));
        schoolSubjectsPage.setAttribute(
          "aria-hidden",
          String(!(isSubjectListPage || isSchoolSubjectsPage)),
        );
        lecturesPage.setAttribute("aria-hidden", String(!isLecturesPage));
        materialsPage.setAttribute("aria-hidden", String(!isMaterialsPage));
        subjectPage.setAttribute("aria-hidden", String(!isSubjectPage));
        communityPage.setAttribute("aria-hidden", String(!isCommunityPage));
        shopPage.setAttribute("aria-hidden", String(!isShopPage));
        contactPage.setAttribute("aria-hidden", String(!isContactPage));
        summaryPanel.classList.toggle(
          "active",
          isSubjectPage &&
            (isSummarySubjectPage ||
              (!isLectureSubjectPage && selectedResourceType === "summary")),
        );
        lecturePanel.classList.toggle(
          "active",
          isSubjectPage &&
            (isLectureSubjectPage ||
              (!isSummarySubjectPage && selectedResourceType === "lecture")),
        );
        if (isSubjectListPage) {
          selectedSchool = pageName.replace("subjects-", "");
          const schoolNames = {
            elementary: "초등학교",
            middle: "중학교",
            high: "고등학교",
            university: "대학교",
          };
          const schoolName = schoolNames[selectedSchool] || "중학교";
          subjectSquares.forEach((square) => {
            const name = square.dataset[`${selectedSchool}Name`];
            const description = square.dataset[`${selectedSchool}Description`];
            const subjectNames = {
              korean: "국어",
              math: "수학",
              english: "영어",
              science: "과학",
              society: "사회",
              history: "역사",
            };
            const subjectDescriptions = {
              korean: "읽기와 표현",
              math: "개념과 문제 풀이",
              english: "단어와 문장",
              science: "탐구와 발견",
              society: "세상과 공동체",
              history: "시간과 이야기",
            };
            square.querySelector("strong").textContent =
              name || subjectNames[square.dataset.subject];
            square.querySelector("span:last-child").textContent =
              description || subjectDescriptions[square.dataset.subject];
          });
        }

        if (isSchoolSubjectsPage) {
          const pageParts = pageName.split("-");
          const resourceType = pageParts[2] || "summary";
          const school = pageParts[3] || "middle";
          selectedResourceType = resourceType;
          selectedSchool = school;
          selectedGrade = 1;
          renderSchoolGrades(school);
          schoolResourceContent.hidden = true;
          currentSubjectId = currentSubjectId || "korean";
          renderSchoolResource(resourceType, school, currentSubjectId, false);
        }

        if (isResourcePage) {
          const resourcePageElement = isNextPage
            ? nextPage
            : isLecturesPage
              ? lecturesPage
              : materialsPage;
          resourcePageElement.querySelector(".resource-subject-grid").hidden =
            true;
        }

        if (isSubjectPage) {
          const subjectPageParts = pageName.split("-");
          const subjectPageOffset =
            isLectureSubjectPage || isSummarySubjectPage ? 2 : 1;
          const school = subjectPageParts[subjectPageOffset];
          const subjectId = subjectPageParts[subjectPageOffset + 1];
          if (isLectureSubjectPage) selectedResourceType = "lecture";
          if (isSummarySubjectPage) selectedResourceType = "summary";
          selectedSchool = school || selectedSchool;
          currentSubjectId = subjectId || currentSubjectId;
          const subject =
            subjectDetails[selectedSchool]?.[subjectId] ||
            subjectDetails.middle.korean;
          const schoolName =
            {
              elementary: "초등학교",
              middle: "중학교",
              high: "고등학교",
              university: "대학교",
            }[selectedSchool] || "중학교";
          subjectEyebrow.textContent = `✓ ${subject.name} 학습`;
          subjectTitle.textContent = `${schoolName} ${subject.name} 학습 공간`;
          subjectDescription.textContent = subject.description;
          subjectConcept.textContent = subject.concept;
          subjectPractice.textContent = subject.practice;
          subjectKnowledge.textContent = subject.knowledge;
          subjectScope.textContent = subject.scope;
          subjectTip.textContent = subject.tip;
          if (selectedResourceType === "lecture") {
            renderLectures(selectedSchool, subjectId);
          } else {
            renderSummary(selectedSchool, subjectId);
          }
        }

        if (isCommunityPage) renderCommunityPosts();
        if (isShopPage) renderShop();

        if (updateHistory) {
          const hash = isHomePage
            ? "#top"
            : isNextPage
              ? `#${pageName}`
              : isContactPage
                ? "#contact-page"
                : `#${pageName}`;
          history.pushState({ page: pageName }, "", hash);
        }

        window.scrollTo({ top: 0, behavior: "smooth" });
      }

      function openModal() {
        modal.classList.add("open");
        modal.setAttribute("aria-hidden", "false");
        loginForm.hidden = false;
        resetForm.classList.remove("active");
        document.getElementById("email").focus();
      }

      function closeModal() {
        modal.classList.remove("open");
        modal.setAttribute("aria-hidden", "true");
        message.textContent = "";
        message.classList.remove("success");
        resetMessage.textContent = "";
      }

      function setLoginProgress(isLoading) {
        loginProgress.classList.toggle("active", isLoading);
        loginSubmit.disabled = isLoading;
        loginSubmit.textContent = isLoading ? "로그인 중..." : "로그인";
      }

      function showResetForm() {
        loginForm.hidden = true;
        resetForm.classList.add("active");
        resetMessage.textContent = "";
        document.getElementById("resetEmail").value = document.getElementById("email").value;
        document.getElementById("resetEmail").focus();
      }

      function showLoginForm() {
        resetForm.classList.remove("active");
        loginForm.hidden = false;
        document.getElementById("email").focus();
      }

      function openSignupModal() {
        closeModal();
        signupModal.classList.add("open");
        signupModal.setAttribute("aria-hidden", "false");
      }

      function closeSignupModal() {
        signupModal.classList.remove("open");
        signupModal.setAttribute("aria-hidden", "true");
        signupMessage.textContent = "";
        signupMessage.classList.remove("success");
      }

      document.addEventListener("pointerdown", (event) => {
        const target = event.target.closest(
          "button, .btn, .subject-square, .school-subject-link",
        );
        if (!target || target.disabled) return;
        const bounds = target.getBoundingClientRect();
        const ripple = document.createElement("span");
        ripple.className = "click-ripple";
        ripple.style.left = `${event.clientX - bounds.left}px`;
        ripple.style.top = `${event.clientY - bounds.top}px`;
        target.appendChild(ripple);
        target.classList.remove("button-pulse");
        void target.offsetWidth;
        target.classList.add("button-pulse");
        ripple.addEventListener("animationend", () => ripple.remove(), {
          once: true,
        });
        window.setTimeout(() => target.classList.remove("button-pulse"), 500);
      });

      openButtons.forEach((button) => {
        button.addEventListener("click", openModal);
      });

      homeLinks.forEach((link) => {
        link.addEventListener("click", () => showPage("home"));
      });
      contactButtons.forEach((button) => {
        button.addEventListener("click", () => {
          showPage("contact");
          loadCurrentUser();
        });
      });
      contactBackButton.addEventListener("click", () => showPage("home"));
      homeNavLinks.forEach((link) => {
        link.addEventListener("click", (event) => {
          event.preventDefault();
          if (link.classList.contains("learning-space-link")) {
            showPage("next");
          } else if (link.classList.contains("lecture-space-link")) {
            showPage("lectures");
          } else if (link.classList.contains("materials-space-link")) {
            showPage("materials");
          } else if (link.classList.contains("community-space-link")) {
            showPage("community");
          } else if (link.classList.contains("shop-space-link")) {
            showPage("shop");
          } else {
            showPage("home");
            document
              .querySelector(link.getAttribute("href"))
              ?.scrollIntoView({ behavior: "smooth" });
          }
        });
      });
      previousPageButtons.forEach((button) => {
        button.addEventListener("click", () => showPage("home"));
      });
      schoolSquares.forEach((square) => {
        square.addEventListener("click", () =>
          showPage(`subjects-${square.dataset.school}`),
        );
      });
      schoolSubjectLinks.forEach((link) => {
        link.addEventListener("click", () =>
          renderSchoolResource(
            selectedResourceType,
            selectedSchool,
            link.dataset.schoolSubject,
          ),
        );
      });
      schoolGradeList.addEventListener("click", (event) => {
        const gradeButton = event.target.closest("[data-school-grade]");
        if (!gradeButton) return;
        selectedGrade = Number(gradeButton.dataset.schoolGrade);
        schoolGradeList.querySelectorAll("[data-school-grade]").forEach((button) => {
          const active = button === gradeButton;
          button.classList.toggle("active", active);
          button.setAttribute("aria-pressed", String(active));
        });
      });
      resourceSchoolSquares.forEach((square) => {
        square.addEventListener("click", () => {
          selectedResourceSchool = square.dataset.resourceSchool;
          const page = square.closest("main");
          const resourceSubjects = page.querySelector(".resource-subject-grid")
            ?.dataset.resourceSubjects;
          const resourceType =
            resourceSubjects === "lectures" ? "lecture" :
              resourceSubjects === "materials" ? "materials" : "summary";
          showSchoolSubjects(resourceType, selectedResourceSchool);
        });
      });
      resourceSubjectSquares.forEach((square) => {
        square.addEventListener("click", () => {
          const resourceSubjects = square.closest("main")?.querySelector(
            ".resource-subject-grid",
          )?.dataset.resourceSubjects;
          const resourceType =
            resourceSubjects === "lectures"
              ? "lecture"
              : resourceSubjects === "materials"
                ? "materials"
                : "summary";
          showSchoolSubjects(
            resourceType,
            selectedResourceSchool,
            square.dataset.resourceSubject,
          );
        });
      });
      subjectSquares.forEach((square) => {
        square.addEventListener("click", () =>
          showPage(`subject-${selectedSchool}-${square.dataset.subject}`),
        );
      });
      subjectListButton.addEventListener("click", () =>
        showPage(selectedResourceType === "lecture" ? "lectures" : "next"),
      );
      window.addEventListener("popstate", () => {
        const hash = window.location.hash;
        showPage(
          hash.startsWith("#subject-") ||
            hash.startsWith("#summary-subject-") ||
            hash.startsWith("#lecture-subject-") ||
              hash.startsWith("#school-subjects-") ||
            hash.startsWith("#subjects-")
            ? hash.replace("#", "")
            : hash === "#lectures" || hash === "#materials"
              ? hash.replace("#", "")
              : hash === "#next"
                ? "next"
                  : hash === "#community"
                    ? "community"
                  : hash === "#shop"
                    ? "shop"
                : hash === "#contact-page"
                  ? "contact"
                  : "home",
          false,
        );
      });
      if (
        window.location.hash.startsWith("#subject-") ||
        window.location.hash.startsWith("#summary-subject-") ||
        window.location.hash.startsWith("#lecture-subject-") ||
        window.location.hash.startsWith("#school-subjects-") ||
        window.location.hash.startsWith("#subjects-")
      )
        showPage(window.location.hash.replace("#", ""), false);
      else if (
        window.location.hash === "#lectures" ||
        window.location.hash === "#materials"
      )
        showPage(window.location.hash.replace("#", ""), false);
      else if (window.location.hash === "#next") showPage("next", false);
      else if (window.location.hash === "#community")
        showPage("community", false);
      else if (window.location.hash === "#shop")
        showPage("shop", false);
      else if (window.location.hash === "#contact-page")
        showPage("contact", false);

      closeButton.addEventListener("click", closeModal);
      signupCloseButton.addEventListener("click", closeSignupModal);
      modal.addEventListener("click", (event) => {
        if (event.target === modal) closeModal();
      });
      signupModal.addEventListener("click", (event) => {
        if (event.target === signupModal) closeSignupModal();
      });

      googleBtn.addEventListener("click", () => {
        message.textContent = "Google 로그인은 Firebase OAuth 제공자 설정 후 연결됩니다.";
        message.classList.remove("success");
      });

      naverBtn.addEventListener("click", () => {
        message.textContent = "네이버 로그인은 Firebase OAuth 제공자 설정 후 연결됩니다.";
        message.classList.remove("success");
      });

      document.querySelectorAll(".password-toggle").forEach((button) => {
        button.addEventListener("click", () => {
          const input = document.getElementById(button.dataset.target);
          const isVisible = input.type === "text";
          input.type = isVisible ? "password" : "text";
          button.textContent = isVisible ? "표시" : "숨기기";
          button.setAttribute(
            "aria-label",
            isVisible ? "비밀번호 표시" : "비밀번호 숨기기",
          );
        });
      });

      forgotPasswordButton.addEventListener("click", showResetForm);
      backToLoginButton.addEventListener("click", showLoginForm);

      resetForm.addEventListener("submit", (event) => {
        event.preventDefault();
        const email = document.getElementById("resetEmail").value.trim();
        resetMessage.classList.remove("success");
        if (!email || !email.includes("@")) {
          resetMessage.textContent = "가입한 이메일 주소를 정확히 입력해 주세요.";
          return;
        }
        resetMessage.textContent =
          "Firebase Auth 연결 후 이 화면에서 재설정 이메일을 발송할 수 있습니다.";
      });

      registerBtn.addEventListener("click", () => {
        openSignupModal();
      });
      signupButtons.forEach((button) => {
        button.addEventListener("click", openSignupModal);
      });

      shopModeTabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const isPurchase = tab.dataset.shopMode === "purchase";
          shopModeTabs.forEach((item) => {
            const active = item === tab;
            item.classList.toggle("active", active);
            item.setAttribute("aria-selected", String(active));
          });
          shopPurchasePanel.hidden = !isPurchase;
          shopChargePanel.hidden = isPurchase;
          renderShop();
        });
      });

      shopGrid.addEventListener("click", (event) => {
        const button = event.target.closest(".shop-add-button");
        if (!button) return;
        const cart = readShopCart();
        if (cart.includes(button.dataset.shopProduct)) {
          shopMessage.textContent = "이미 장바구니에 담긴 상품입니다.";
          shopMessage.classList.remove("success");
          return;
        }
        cart.push(button.dataset.shopProduct);
        saveShopCart(cart);
        shopMessage.textContent = "상품을 장바구니에 담았습니다.";
        shopMessage.classList.add("success");
        renderShopCart();
      });

      shopCartList.addEventListener("click", (event) => {
        const button = event.target.closest(".shop-remove-button");
        if (!button) return;
        const cart = readShopCart();
        cart.splice(Number(button.dataset.shopIndex), 1);
        saveShopCart(cart);
        renderShopCart();
      });

      shopPurchaseButton.addEventListener("click", () => {
        const cart = readShopCart();
        const total = cart.reduce((sum, id) => {
          const product = shopProducts.find((item) => item.id === id);
          return sum + (product?.price || 0);
        }, 0);
        const points = readShopPoints();
        shopMessage.classList.remove("success");
        if (!cart.length) {
          shopMessage.textContent = "먼저 장바구니에 상품을 담아 주세요.";
          return;
        }
        if (total > points) {
          shopMessage.textContent = "포인트가 부족합니다.";
          return;
        }
        cart.forEach((id) => {
          const product = shopProducts.find((item) => item.id === id);
          if (product?.entitlement)
            saveShopEntitlement(product.entitlement, product.durationDays);
        });
        localStorage.setItem(shopPointsKey, String(points - total));
        saveShopCart([]);
        shopMessage.textContent = "교환이 완료되었습니다.";
        shopMessage.classList.add("success");
        renderShop();
      });

      shopCurrencyGrid.addEventListener("click", (event) => {
        const button = event.target.closest(".shop-buy-currency");
        if (!button) return;
        const amount = Number(button.dataset.shopAmount);
        localStorage.setItem(shopPointsKey, String(readShopPoints() + amount));
        shopMessage.textContent = `${amount.toLocaleString("ko-KR")} 포인트 충전이 완료되었습니다. 실제 결제 연동 전 테스트 주문입니다.`;
        shopMessage.classList.add("success");
        renderShop();
      });

      communityForm.addEventListener("submit", (event) => {
        event.preventDefault();
        communityFormMessage.textContent = "";
        const title = communityTitle.value.trim();
        const body = communityBody.value.trim();
        if (!title || !body) {
          communityFormMessage.textContent = "제목과 내용을 모두 입력해 주세요.";
          return;
        }
        const posts = readCommunityPosts();
        posts.unshift({
          id: `${Date.now()}-${Math.random().toString(36).slice(2)}`,
          title,
          body,
          createdAt: new Date().toISOString(),
          comments: [],
        });
        saveCommunityPosts(posts);
        communityForm.reset();
        renderCommunityPosts();
      });

      communityList.addEventListener("submit", (event) => {
        if (!event.target.matches(".community-comment-form")) return;
        event.preventDefault();
        const form = event.target;
        const card = form.closest("[data-community-post-id]");
        const comment = form.elements.comment.value.trim();
        if (!card || !comment) return;
        const posts = readCommunityPosts();
        const post = posts.find(
          (item) => item.id === card.dataset.communityPostId,
        );
        if (!post) return;
        post.comments = [...(post.comments || []), comment];
        saveCommunityPosts(posts);
        renderCommunityPosts();
      });

      communityList.addEventListener("click", (event) => {
        const button = event.target.closest(".community-delete-button");
        if (!button) return;
        const card = button.closest("[data-community-post-id]");
        if (!card) return;
        const posts = readCommunityPosts().filter(
          (post) => post.id !== card.dataset.communityPostId,
        );
        saveCommunityPosts(posts);
        renderCommunityPosts();
      });

      lectureForm.addEventListener("submit", (event) => {
        event.preventDefault();
        lectureFormMessage.textContent = "";
        const videoId = getYoutubeId(lectureUrl.value.trim());
        if (!videoId || !/^[A-Za-z0-9_-]{11}$/.test(videoId)) {
          lectureFormMessage.textContent =
            "유효한 유튜브 영상 주소를 입력해 주세요.";
          return;
        }
        const lectures = readLectures(selectedSchool, currentSubjectId);
        lectures.unshift({
          id: `${Date.now()}-${Math.random().toString(36).slice(2)}`,
          title: lectureTitle.value.trim(),
          videoId,
          comments: [],
        });
        saveLectures(selectedSchool, currentSubjectId, lectures);
        lectureForm.reset();
        renderLectures(selectedSchool, currentSubjectId);
      });

      lectureList.addEventListener("submit", (event) => {
        if (!event.target.matches(".lecture-comment-form")) return;
        event.preventDefault();
        const form = event.target;
        const card = form.closest("[data-lecture-id]");
        const comment = form.elements.comment.value.trim();
        if (!comment || !card) return;
        const lectures = readLectures(selectedSchool, currentSubjectId);
        const lecture = lectures.find((item) => item.id === card.dataset.lectureId);
        if (!lecture) return;
        lecture.comments = [...(lecture.comments || []), comment];
        saveLectures(selectedSchool, currentSubjectId, lectures);
        renderLectures(selectedSchool, currentSubjectId);
      });

      lectureList.addEventListener("click", (event) => {
        const button = event.target.closest(".delete-lecture-button");
        if (!button) return;
        const card = button.closest("[data-lecture-id]");
        const lectures = readLectures(selectedSchool, currentSubjectId).filter(
          (lecture) => lecture.id !== card.dataset.lectureId,
        );
        saveLectures(selectedSchool, currentSubjectId, lectures);
        renderLectures(selectedSchool, currentSubjectId);
      });

      postForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        postFormMessage.textContent = "";
        try {
          await apiRequest("/posts", {
            method: "POST",
            body: JSON.stringify({
              title: document.getElementById("postTitle").value,
              body: document.getElementById("postBody").value,
            }),
          });
          postForm.reset();
          await loadPosts();
        } catch (error) {
          postFormMessage.textContent = error.message;
        }
      });

      postList.addEventListener("submit", async (event) => {
        if (!event.target.matches(".comment-form")) return;
        event.preventDefault();
        const form = event.target;
        const postId = form.dataset.postId;
        const parentId = form.dataset.parentId || null;
        const body = form.elements.body.value;
        try {
          await apiRequest(`/posts/${postId}/comments`, {
            method: "POST",
            body: JSON.stringify({ body, parentId }),
          });
          await loadPosts();
        } catch (error) {
          form.insertAdjacentHTML(
            "beforeend",
            `<p class="inline-error">${escapeHtml(error.message)}</p>`,
          );
        }
      });

      postList.addEventListener("click", async (event) => {
        const button = event.target.closest("button");
        if (!button) return;
        const postCard = button.closest("[data-post-id]");
        const postId = postCard?.dataset.postId;
        const commentId = button.dataset.commentId;
        try {
          if (button.classList.contains("delete-post-button")) {
            if (confirm("이 문의 글을 삭제할까요?")) {
              await apiRequest(`/posts/${postId}`, { method: "DELETE" });
              await loadPosts();
            }
          } else if (button.classList.contains("edit-post-button")) {
            const title = prompt(
              "수정할 제목을 입력하세요.",
              postCard.querySelector("h3").textContent,
            );
            const body = prompt(
              "수정할 내용을 입력하세요.",
              postCard.querySelector(".post-body").textContent,
            );
            if (title !== null && body !== null) {
              await apiRequest(`/posts/${postId}`, {
                method: "PATCH",
                body: JSON.stringify({ title, body }),
              });
              await loadPosts();
            }
          } else if (button.classList.contains("delete-comment-button")) {
            if (confirm("이 댓글을 삭제할까요?")) {
              await apiRequest(`/comments/${commentId}`, { method: "DELETE" });
              await loadPosts();
            }
          } else if (button.classList.contains("edit-comment-button")) {
            const comment = button.closest(".comment");
            const body = prompt(
              "수정할 댓글을 입력하세요.",
              comment.querySelector(".comment-body").textContent,
            );
            if (body !== null) {
              await apiRequest(`/comments/${commentId}`, {
                method: "PATCH",
                body: JSON.stringify({ body }),
              });
              await loadPosts();
            }
          } else if (button.classList.contains("reply-comment-button")) {
            const replyForm = document.createElement("form");
            replyForm.className = "comment-form";
            replyForm.dataset.postId = postId;
            replyForm.dataset.parentId = commentId;
            replyForm.innerHTML =
              '<textarea name="body" placeholder="답글을 입력하세요." required></textarea><button type="submit" class="btn btn-secondary">답글 남기기</button>';
            button.closest(".comment").appendChild(replyForm);
            button.disabled = true;
          }
        } catch (error) {
          alert(error.message);
        }
      });

      signupForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        signupMessage.textContent = "계정을 만드는 중입니다...";
        signupMessage.classList.remove("success");

        try {
          const response = await fetch(`${authApiUrl}/auth/signup`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            credentials: "include",
            body: JSON.stringify({
              name: document.getElementById("signupName").value.trim(),
              email: document.getElementById("signupEmail").value.trim(),
              password: document.getElementById("signupPassword").value,
            }),
          });
          const data = await response.json();

          if (!response.ok)
            throw new Error(data.message || "회원가입에 실패했습니다.");

          signupMessage.textContent =
            "회원가입이 완료되었습니다. 이제 로그인할 수 있습니다.";
          signupMessage.classList.add("success");
          currentUser = data.user;
          updateDashboard(currentUser);
          signupForm.reset();
        } catch (error) {
          signupMessage.textContent = error.message.includes("Failed to fetch")
            ? "백엔드 서버를 먼저 실행해 주세요. (localhost:4000)"
            : error.message;
        }
      });

      loginForm.addEventListener("submit", async (event) => {
        event.preventDefault();

        const email = document.getElementById("email").value.trim();
        const password = document.getElementById("password").value;

        if (!email || !password) {
          message.textContent = "이메일과 비밀번호를 모두 입력해 주세요.";
          message.classList.remove("success");
          return;
        }

        if (!email.includes("@")) {
          message.textContent = "올바른 이메일 주소를 입력해 주세요.";
          message.classList.remove("success");
          return;
        }

        if (password.length < 8) {
          message.textContent = "비밀번호는 8자 이상 입력해 주세요.";
          message.classList.remove("success");
          return;
        }

        setLoginProgress(true);
        try {
          const data = await apiRequest("/auth/login", {
            method: "POST",
            body: JSON.stringify({ email, password }),
          });
          currentUser = data.user;
          updateDashboard(currentUser);
          if (document.getElementById("rememberLogin").checked) {
            localStorage.setItem("buildup-remembered-email", email);
          } else {
            localStorage.removeItem("buildup-remembered-email");
          }
          message.textContent = "로그인 성공! 환영합니다.";
          message.classList.add("success");
          setTimeout(() => {
            closeModal();
            loginForm.reset();
          }, 500);
        } catch (error) {
          message.textContent = error.message.includes("Failed to fetch")
            ? "백엔드 서버를 먼저 실행해 주세요. (localhost:4000)"
            : error.message;
          message.classList.remove("success");
        } finally {
          setLoginProgress(false);
        }
      });

      const rememberedEmail = localStorage.getItem("buildup-remembered-email");
      if (rememberedEmail) {
        document.getElementById("email").value = rememberedEmail;
        document.getElementById("rememberLogin").checked = true;
      }

      loadCurrentUser();
    </script>
  </body>
</html>
