          <div class="contact-toolbar">
            <p class="auth-status" id="authStatus">
              로그인 상태를 확인하는 중입니다.
            </p>
          </div>

          <form class="post-form" id="postForm" hidden>
            <input
              id="postTitle"
              type="text"
              placeholder="문의 제목"
              required
            />
            <textarea
              id="postBody"
              placeholder="문의 내용을 입력하세요."
              required
            ></textarea>
            <button type="submit" class="btn btn-primary">문의 글 작성</button>
            <p class="inline-error" id="postFormMessage"></p>
          </form>

          <div class="post-list" id="postList">
            <p class="auth-status">로그인하면 문의 글을 확인할 수 있습니다.</p>
          </div>

          <div class="page-controls">
            <button type="button" class="btn btn-secondary contact-back-button">
              ← 이전 페이지
            </button>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <div>© <span id="year"></span> 빌드업. All rights reserved.</div>
        <div>공부를 만드는 힘, Build Up</div>
      </div>
    </footer>

    <div class="modal" id="loginModal" aria-hidden="true">
      <div
        class="modal-panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="loginTitle"
      >
        <div class="modal-header">
          <h3 id="loginTitle">로그인</h3>
          <button type="button" class="close-btn" aria-label="닫기">×</button>
        </div>

        <form class="login-form" id="loginForm">
          <div class="social-login">
            <button type="button" class="social-btn google">Google</button>
            <button type="button" class="social-btn naver">Naver</button>
          </div>

          <div class="divider">또는 이메일 로그인</div>

          <label>
            이메일
            <input
              type="email"
              id="email"
              placeholder="name@example.com"
              autocomplete="email"
              required
            />
          </label>

          <label>
            비밀번호
            <div class="input-wrap">
              <input
                type="password"
                id="password"
                placeholder="8자 이상 입력하세요"
                autocomplete="current-password"
                minlength="8"
                required
              />
              <button type="button" class="input-action password-toggle" data-target="password" aria-label="비밀번호 표시">표시</button>
            </div>
            <p class="field-hint">영문, 숫자, 특수문자를 조합하면 더 안전합니다.</p>
          </label>

          <div class="form-row">
            <label
              style="
                flex-direction: row;
                align-items: center;
                gap: 8px;
                font-weight: 500;
              "
            >
              <input type="checkbox" id="rememberLogin" />
              로그인 유지
            </label>
            <button type="button" class="back-to-login" id="forgotPasswordButton">비밀번호 찾기</button>
          </div>

          <p class="message" id="message"></p>
          <div class="auth-progress" id="loginProgress" aria-live="polite">로그인 확인 중입니다...</div>

          <button type="submit" class="btn btn-primary" id="loginSubmit" style="width: 100%">
            로그인
          </button>
        </form>

        <form class="reset-panel" id="resetForm" novalidate>
          <p>가입한 이메일을 입력하면 비밀번호 재설정 안내를 받을 수 있습니다.</p>
          <label>
            이메일
            <input type="email" id="resetEmail" placeholder="name@example.com" autocomplete="email" required />
          </label>
          <p class="message" id="resetMessage" aria-live="polite"></p>
          <button type="submit" class="btn btn-primary">재설정 이메일 보내기</button>
          <button type="button" class="back-to-login" id="backToLoginButton">로그인으로 돌아가기</button>
        </form>

        <div class="register-wrap">
          <button type="button" class="register-btn" id="registerBtn">
            회원가입
          </button>
        </div>
      </div>
    </div>

    <div class="modal" id="signupModal" aria-hidden="true">
      <div
        class="modal-panel signup-modal-panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="signupTitle"
      >
        <div class="modal-header">
          <h3 id="signupTitle">회원가입</h3>
          <button
            type="button"
            class="close-btn signup-close-btn"
            aria-label="닫기"
          >
            ×
          </button>
        </div>

        <form class="login-form" id="signupForm">
          <label>
            이름
            <input type="text" id="signupName" placeholder="홍길동" required />
          </label>

          <label>
            이메일
            <input
              type="email"
              id="signupEmail"
              placeholder="name@example.com"
              required
            />
          </label>

          <label>
            비밀번호
            <input
              type="password"
              id="signupPassword"
              placeholder="8자 이상 입력하세요"
              minlength="8"
              required
            />
          </label>

          <p class="message" id="signupMessage"></p>
          <button type="submit" class="btn btn-primary" style="width: 100%">
            계정 만들기
          </button>
        </form>
      </div>
    </div>

