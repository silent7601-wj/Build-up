            checklist: ["사료의 맥락과 작성 목적을 분석할 수 있다.", "역사적 변화의 의미를 현재와 연결할 수 있다."],
          },
        },
      };
      let currentUser = null;

      function escapeHtml(value) {
        return String(value).replace(
          /[&<>'"]/g,
          (character) =>
            ({
              "&": "&amp;",
              "<": "&lt;",
              ">": "&gt;",
              "'": "&#039;",
              '"': "&quot;",
            })[character],
        );
      }

      function dashboardStorageKey(user) {
        return `buildup-dashboard-${user?.id || "guest"}`;
      }

      function readDashboardStats(user) {
        const defaults = user ? newUserDashboardStats : publicDashboardStats;
        let storedStats = {};
        try {
          storedStats = JSON.parse(
            localStorage.getItem(dashboardStorageKey(user)) || "{}",
          );
        } catch {
          storedStats = {};
        }
        return {
          ...defaults,
          ...(user?.learningStats || user?.stats || {}),
          ...storedStats,
        };
      }

      function updateDashboard(user = currentUser) {
        const stats = readDashboardStats(user);
        metricActiveLearners.textContent = stats.activeLearners;
        metricGoalRate.textContent = stats.goalRate;
        metricFocusGain.textContent = stats.focusGain;
        dashboardTitle.textContent = user
          ? `${user.name || "나의"} 주간 학습 리포트`
          : "이번 주 학습 리포트";
        dashboardTrend.textContent = stats.trend;
        dashboardHours.textContent = stats.weeklyHours;
        dashboardCompletion.textContent = stats.completion;
        dashboardStreak.textContent = stats.streak;
      }

      async function apiRequest(path, options = {}) {
        const response = await fetch(`${authApiUrl}${path}`, {
          ...options,
          credentials: "include",
          headers: {
            "Content-Type": "application/json",
            ...(options.headers || {}),
          },
        });
        const data = response.status === 204 ? null : await response.json();
        if (!response.ok)
          throw new Error(data?.message || "요청을 처리하지 못했습니다.");
        return data;
      }

      function commentTree(comments, parentId = null, depth = 0) {
        return comments
          .filter((comment) => comment.parentId === parentId)
          .map(
            (comment) => `
            <div class="comment ${depth ? "reply" : ""}">
              <div class="comment-header"><strong>${escapeHtml(comment.author.name)}</strong><span class="comment-meta">${new Date(comment.createdAt).toLocaleString("ko-KR")}</span></div>
              <p class="comment-body">${escapeHtml(comment.body)}</p>
              <div class="comment-actions">
                <button type="button" class="text-button reply-comment-button" data-comment-id="${comment.id}">답글</button>
                ${currentUser?.id === comment.author.id ? `<span><button type="button" class="text-button edit-comment-button" data-comment-id="${comment.id}">수정</button> <button type="button" class="text-button danger delete-comment-button" data-comment-id="${comment.id}">삭제</button></span>` : ""}
              </div>
              ${commentTree(comments, comment.id, depth + 1)}
            </div>
          `,
          )
          .join("");
      }

      function renderPosts(posts) {
        if (!posts.length) {
          postList.innerHTML =
            '<p class="auth-status">아직 작성된 문의가 없습니다. 첫 문의를 남겨 보세요.</p>';
          return;
        }
        postList.innerHTML = posts
          .map(
            (post) => `
          <article class="post-card" data-post-id="${post.id}">
            <div class="post-header"><div><h3>${escapeHtml(post.title)}</h3><span class="post-meta">${escapeHtml(post.author.name)} · ${new Date(post.createdAt).toLocaleString("ko-KR")}</span></div>
              ${currentUser?.id === post.author.id ? `<span class="post-actions"><button type="button" class="text-button edit-post-button">수정</button><button type="button" class="text-button danger delete-post-button">삭제</button></span>` : ""}
            </div>
            <p class="post-body">${escapeHtml(post.body)}</p>
            <div class="comment-box">
              <strong>댓글 ${post.comments.length}개</strong>
              <div class="comment-list">${commentTree(post.comments)}</div>
              <form class="comment-form" data-post-id="${post.id}"><textarea name="body" placeholder="댓글을 입력하세요." required></textarea><button type="submit" class="btn btn-secondary">댓글 남기기</button></form>
            </div>
          </article>
        `,
          )
          .join("");
      }

      async function loadPosts() {
        try {
          const data = await apiRequest("/posts");
          renderPosts(data.posts);
        } catch (error) {
          postList.innerHTML = `<p class="inline-error">${escapeHtml(error.message)}</p>`;
        }
      }

      async function loadCurrentUser() {
        try {
          const data = await apiRequest("/auth/me");
          currentUser = data.user;
        } catch {
          currentUser = null;
        }
        updateDashboard(currentUser);
        authStatus.textContent = currentUser
          ? `${currentUser.name}님으로 로그인했습니다.`
          : "문의 글을 작성하려면 로그인이 필요합니다.";
        postForm.hidden = !currentUser;
        if (currentUser) loadPosts();
      }

      function lectureStorageKey(school, subjectId) {
        return `buildup-lectures-${school}-${subjectId}`;
      }

      function getYoutubeId(value) {
        try {
          const url = new URL(value);
          if (url.hostname === "youtu.be") return url.pathname.slice(1);
          if (url.hostname.includes("youtube.com")) {
            return (
              url.searchParams.get("v") ||
              url.pathname.match(/\/(?:embed|shorts)\/([^/?]+)/)?.[1] ||
              ""
            );
          }
        } catch {
          return "";
        }
        return "";
      }

      function readLectures(school, subjectId) {
        try {
          return JSON.parse(
            localStorage.getItem(lectureStorageKey(school, subjectId)) || "[]",
          );
        } catch {
          return [];
        }
      }

      function saveLectures(school, subjectId, lectures) {
        localStorage.setItem(
          lectureStorageKey(school, subjectId),
          JSON.stringify(lectures),
        );
      }

      function renderLectures(school, subjectId) {
        const lectures = readLectures(school, subjectId);
        if (!lectures.length) {
          lectureList.innerHTML =
            '<p class="auth-status">등록한 강의가 여기에 표시됩니다.</p>';
          return;
        }
        lectureList.innerHTML = lectures
          .map(
            (lecture) => `
              <article class="lecture-card" data-lecture-id="${lecture.id}">
                <iframe class="lecture-video" src="https://www.youtube.com/embed/${encodeURIComponent(lecture.videoId)}" title="${escapeHtml(lecture.title)}" allowfullscreen></iframe>
                <div class="lecture-card-body">
                  <div class="lecture-card-header">
                    <h3>${escapeHtml(lecture.title)}</h3>
                    <button type="button" class="text-button danger delete-lecture-button">삭제</button>
                  </div>
                  <div class="lecture-comment-list">
                    ${(lecture.comments || []).length
                      ? lecture.comments
                          .map(
                            (comment) =>
                              `<div class="lecture-comment">${escapeHtml(comment)}</div>`,
                          )
                          .join("")
                      : '<p class="auth-status">첫 댓글을 남겨 보세요.</p>'}
                  </div>
                  <form class="lecture-comment-form">
                    <input name="comment" type="text" placeholder="이 강의에 댓글 남기기" required />
                    <button type="submit" class="btn btn-secondary">댓글</button>
                  </form>
                </div>
              </article>
            `,
          )
          .join("");
      }

      function renderSummary(school, subjectId) {
        const summary =
          curriculumSummaries[school]?.[subjectId] ||
          curriculumSummaries.middle[subjectId];
        summaryCore.textContent = summary.core;
        summaryAchievement.textContent = summary.achievement;
        summaryQuestion.textContent = summary.question;
        summaryCurriculumNote.textContent =
          school === "university"
            ? "고등학교 2022 개정 교육과정의 기초를 바탕으로 전공 학습에 연결해 복습해 보세요."
            : `${school === "elementary" ? "초등학교" : school === "middle" ? "중학교" : "고등학교"} ${subjectDetails[school]?.[subjectId]?.name || "과목"}의 2022 개정 교육과정 핵심 내용을 정리했습니다.`;
        summaryKeywords.innerHTML = summary.keywords
          .map((keyword) => `<span>${escapeHtml(keyword)}</span>`)
          .join("");
        summaryChecklist.innerHTML = summary.checklist
          .map(
            (item, index) =>
              `<label><input type="checkbox" data-summary-check="${school}-${subjectId}-${index}" />${escapeHtml(item)}</label>`,
          )
          .join("");
        summaryChecklist.querySelectorAll("input").forEach((checkbox) => {
          const key = checkbox.dataset.summaryCheck;
          checkbox.checked = localStorage.getItem(`buildup-check-${key}`) === "1";
          checkbox.addEventListener("change", () =>
            localStorage.setItem(`buildup-check-${key}`, checkbox.checked ? "1" : "0"),
          );
        });
      }

      const communityStorageKey = "buildup-community-posts";

      function readCommunityPosts() {
        try {
          return JSON.parse(localStorage.getItem(communityStorageKey) || "[]");
        } catch {
          return [];
        }
      }

      function saveCommunityPosts(posts) {
        localStorage.setItem(communityStorageKey, JSON.stringify(posts));
      }

      function renderCommunityPosts() {
        const posts = readCommunityPosts();
        communityCount.textContent = `${posts.length}개의 글`;
        if (!posts.length) {
          communityList.innerHTML =
            '<p class="auth-status">아직 글이 없습니다. 첫 글을 남겨 보세요.</p>';
          return;
        }
        communityList.innerHTML = posts
          .map(
            (post) => `
              <article class="community-card" data-community-post-id="${post.id}">
                <div class="community-card-header">
                  <div>
                    <h2>${escapeHtml(post.title)}</h2>
                    <span class="community-meta">익명 학습자 · ${new Date(post.createdAt).toLocaleString("ko-KR")}</span>
                  </div>
                  <button type="button" class="text-button danger community-delete-button">삭제</button>
                </div>
                <p class="community-body">${escapeHtml(post.body)}</p>
                <div class="community-comments">
                  ${(post.comments || []).length
                    ? post.comments
                        .map(
                          (comment) =>
                            `<div class="community-comment">${escapeHtml(comment)}</div>`,
                        )
                        .join("")
                    : '<span class="community-meta">첫 댓글을 남겨 보세요.</span>'}
                </div>
                <form class="community-comment-form">
                  <input name="comment" type="text" maxlength="500" placeholder="댓글을 입력하세요" required />
                  <button type="submit" class="btn btn-secondary">댓글</button>
                </form>
              </article>
            `,
          )
          .join("");
      }

